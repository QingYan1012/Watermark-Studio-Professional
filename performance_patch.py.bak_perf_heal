    return (
        perf_ok or undo_ok or undo_obs_ok or theme_ok or theme_pref_ok or export_ok or export_cur_ok
        or persp_ok or async_ok or prefetch_ok or svc_log_ok or smart_ok
        or canvas_ix_ok or panel_border_ok or async_list_ok
    )


install()


# ============================================================
# 直角终结者 —— 整段粘到 performance_patch.py 文件最末尾，保存即可。
# 不改 main.py、不新建文件、不用找锚点。
#
# 已决定不要圆角。直角没有“圆角外切角”，黑角/亮线/亮框的病根
# 随之整个消失，跟描边色、跟中间拖拽条底色都无关 —— 所以这次不再
# 调任何颜色，一次到位。本段对前面所有边角补丁的执行顺序免疫：
# 无论它跑在 install() 之前还是之后，面板/工具栏/底栏最终都是
# 直角 + 无描边，中间拖拽条 = 窗口底色，亮暗两态都干净。
# ============================================================
try:
    _RF_LEG = _find_legacy_module()
    _RF_THEME = getattr(_RF_LEG, "THEME", {}) if _RF_LEG else {}
    _RF_T = getattr(_RF_LEG, "T", None) if _RF_LEG else None
    _RF_App = _find_app_class()

    def _rf_panel(self, master):
        # 面板父是 tk.PanedWindow，圆角必黑 → 直角；去描边，浮起靠色差。
        return ctk.CTkFrame(master, corner_radius=0, fg_color=_RF_T("panel"), border_width=0)

    def _rf_strip(frame):
        if frame is None:
            return
        try:
            frame.configure(corner_radius=0, border_width=0)
        except Exception:
            pass

    if _RF_App is not None and ctk is not None and _RF_T is not None:
        try:
            _RF_App._panel = _rf_panel
        except Exception:
            pass

        if hasattr(_RF_App, "_build_layout"):
            _rf_ol = _RF_App._build_layout

            def _rf_build_layout(self):
                try:
                    _RF_App._panel = _rf_panel          # orig 前钉死直角面板
                except Exception:
                    pass
                _rf_ol(self)                             # 跑完整条 build 链
                _rf_strip(getattr(self, "_toolbar", None))      # orig 后统一直角无描边
                _rf_strip(getattr(self, "_bottom_bar", None))   # （盖住任何前序描边/圆角）
                mp = getattr(self, "main_paned", None)
                if mp is not None:
                    try:
                        mp.configure(bg=_RF_THEME.get("bg"))
                    except Exception:
                        pass
                    try:
                        _nw = getattr(_RF_LEG, "_NATIVE_WIDGETS", None)
                        if _nw is not None:
                            for _w, _roles in _nw:
                                if _w is mp and isinstance(_roles, dict):
                                    _roles["bg"] = "bg"
                    except Exception:
                        pass

            _RF_App._build_layout = _rf_build_layout

        try:
            _log.info("rect_final: 直角终结者已安装")
        except Exception:
            pass
except Exception:
    try:
        _log.exception("rect_final 异常（已跳过，软件照常运行）")
    except Exception:
        pass