def _perf_load_state(self):
    try:
        if self.current_index is None or not self.images:
            return "empty"
        e = self.images[self.current_index]
        if getattr(e, "pil_image", None) is not None:
            return "ready"
        if getattr(e, "_load_failed", False):
            return "failed"
        return "loading"
    except Exception:
        return "empty"


