def _perf_toggle_theme(self):
    new_mode = "dark" if self.theme_mode == "light" else "light"
    self.theme_mode = new_mode

    legacy = _find_legacy_module()

    try:
        if legacy is not None and callable(getattr(legacy, "_apply_theme", None)):
            legacy._apply_theme(new_mode)
    except Exception:
        pass

    try:
        import customtkinter as _ctk
        _ctk.set_appearance_mode(new_mode)
    except Exception:
        pass

    try:
        if legacy is not None and callable(getattr(legacy, "_retheme_native", None)):
            legacy._retheme_native()
    except Exception:
        pass

    try:
