def _draw_empty_state(self):
    """空状态门面重排。legacy 原空分支把『还没有照片』与四行引导压得太近、
    且都水平居中 → 短标题插进长首行的视觉缝隙，糊成一团；又不画点阵、画布发空。

    零白屏策略：先把 canvas 上 legacy 那两行旧文字 hidden，画好新内容后再 delete；
    若新内容绘制异常，except 里把旧文字 unhide 恢复 → 最坏回到 legacy 原样，绝不白屏。
    （空状态 original_redraw_canvas 开头已 delete("all")，故此刻 canvas 上恰为那两行旧文字，
    find_all 精准命中；zoom label 是 place 的控件、不在 canvas item 内，不受影响。）

    新排版：补点阵质感 + 品牌 eyebrow + 标题/副标题/四步引导垂直舒展居中、字号字重分层。
    颜色读单值 THEME（空状态不交互，切主题时 _redraw_canvas 重跑即用新色）。
    """
    legacy = _find_legacy_module()
    THEME = getattr(legacy, "THEME", {}) if legacy else {}
    disp_font = getattr(legacy, "_disp_font", None) if legacy else None

    # 1) 隐藏 legacy 旧文字（保留 id 以便失败时恢复）
    old_ids = []
    try:
        old_ids = list(self.canvas.find_all())
        for oid in old_ids:
            self.canvas.itemconfigure(oid, state="hidden")
    except Exception:
        old_ids = []

    try:
        cw = max(200, self.canvas.winfo_width())
        ch = max(120, self.canvas.winfo_height())

        try:
            self.canvas.create_image(
                0, 0, anchor="nw", image=self._ensure_dotgrid(cw, ch), tags="bg",
            )
        except Exception:
            pass

        col_eye = THEME.get("accent", "#3370ff")
        col_title = THEME.get("text", "#1f2329")
        col_sub = THEME.get("text_dim", "#767d87")
        col_step = THEME.get("text_mid", "#4e5560")
        f_eye = disp_font(11, True) if disp_font else ("Microsoft YaHei", 11, "bold")
        f_title = disp_font(20, True) if disp_font else ("Microsoft YaHei", 20, "bold")
        f_sub = disp_font(12, False) if disp_font else ("Microsoft YaHei", 12)
        f_step = disp_font(13, False) if disp_font else ("Microsoft YaHei", 13)

        steps = [
            "①   点左上『打开图片 / 打开文件夹』导入照片",
            "②   在右侧调水印，或直接拖动画布上的文字 / 图标",
            "③   点『导入数据表』批量填充 {字段}",
            "④   点右下绿色『批量导出全部』",
        ]
        line_h = 30
        block_h = 22 + 30 + 24 + 16 + len(steps) * line_h
        top = max(48, (ch - block_h) // 2)
        cx = cw // 2

        self.canvas.create_text(cx, top, anchor="n", fill=col_eye,
                                text="W A T E R M A R K    S T U D I O", font=f_eye)
        self.canvas.create_text(cx, top + 22, anchor="n", fill=col_title,
                                text="还没有照片", font=f_title)
        self.canvas.create_text(cx, top + 22 + 30, anchor="n", fill=col_sub,
                                text="四步开始你的批量水印标注", font=f_sub)

        y = top + 22 + 30 + 24 + 16
        for s in steps:
            self.canvas.create_text(cx, y, anchor="n", fill=col_step, text=s, font=f_step)
            y += line_h

        try:
            self.canvas.configure(scrollregion=(0, 0, cw, ch))
        except Exception:
            pass
        try:
            if hasattr(self, "canvas_warning_label"):
                self.canvas_warning_label.configure(text="")
        except Exception:
            pass
    except Exception:
        # 重画失败 → 恢复 legacy 旧文字，杜绝白屏
        for oid in old_ids:
            try:
                self.canvas.itemconfigure(oid, state="normal")
            except Exception:
                pass
        return

    # 重画成功 → 删掉已隐藏的 legacy 旧文字（下一帧 delete("all") 也会清，这里提前清）
    for oid in old_ids:
        try:
            self.canvas.delete(oid)
        except Exception:
            pass


