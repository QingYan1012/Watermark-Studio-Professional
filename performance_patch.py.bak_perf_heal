# 服务层可观测性：外层包装 ui.services 入口函数记 debug 日志
# ======================================================================

def _svc_corners_bbox(cs):
    try:
        xs = [c[0] for c in cs]
        ys = [c[1] for c in cs]
        l, r = min(xs), max(xs)
        t, b = min(ys), max(ys)
        return "(%.3f,%.3f)-(%.3f,%.3f) area=%.3f" % (l, t, r, b, (r - l) * (b - t))
    except Exception:
        return "?"


def _wrap_svc(name, fn, summarize):
    def wrapped(*a, **kw):
        t0 = time.perf_counter()
        try:
            res = fn(*a, **kw)
        except Exception:
            _plog.exception("svc %s raised", name)
            raise
        dt = (time.perf_counter() - t0) * 1000.0
        try:
            _plog.debug("svc %-22s %6.1fms | %s", name, dt, summarize(res, a, kw))
        except Exception:
            pass
        return res

    try:
        wrapped.__name__ = name
        wrapped.__qualname__ = name
        wrapped.__wrapped__ = fn
    except Exception:
        pass
    return wrapped


def _install_services_logging():
    if not _SVC_LOG_ENABLED:
        return False

    try:
        from ui.services import autodetect as _ad, edge_snap as _es, warp as _wp
    except Exception:
        _plog.exception("import ui.services 失败，跳过服务层日志")
        return False

    def _sum_corners(res, a, kw):
        if res is None:
            return "None"
        return "corners %s" % _svc_corners_bbox(res)

    def _sum_refine(res, a, kw):
        if res is None:
            return "None(框未变/退化)"
        try:
            inp = a[1] if len(a) > 1 else kw.get("corners_rel")
            d = max(abs(res[i][0] - inp[i][0]) + abs(res[i][1] - inp[i][1]) for i in range(4))
            return "refined maxΔ=%.4f %s" % (d, _svc_corners_bbox(res))
        except Exception:
            return "refined %s" % _svc_corners_bbox(res)

    def _sum_bend(res, a, kw):
        try:
            return "edges pts=%s" % [len(res.get(i, [])) for i in range(4)]
        except Exception:
            return "edges ?"

    def _sum_scan(res, a, kw):
        try:
            box, real = res
            return "box=%s real=%d" % ("None" if box is None else _svc_corners_bbox(box), real)
        except Exception:
            return "?"

    def _sum_warp(res, a, kw):
        try:
            return "out %dx%d" % (res.size[0], res.size[1])
        except Exception:
            return "out ?"

    def _sum_warp_scaled(res, a, kw):
        try:
            le = a[2] if len(a) > 2 else kw.get("long_edge", "?")
            return "out %dx%d long_edge=%s" % (res.size[0], res.size[1], le)
        except Exception:
            return "out ?"

    targets = [
        (_ad, "autodetect_corners", _sum_corners),
        (_ad, "autodetect_cv", _sum_corners),
        (_ad, "autodetect_v3", _sum_corners),
        (_es, "refine_box_edges", _sum_refine),
        (_es, "bend_refine_edge_points", _sum_bend),
        (_es, "scan_box", _sum_scan),
        (_wp, "warp_corners", _sum_warp),
        (_wp, "warp_scaled", _sum_warp_scaled),
    ]

    n = 0
    for mod, attr, summ in targets:
        fn = getattr(mod, attr, None)
        if fn is None:
            continue
        if getattr(fn, "_ws_svc_logged", False):
            continue
        w = _wrap_svc(attr, fn, summ)
        w._ws_svc_logged = True
        try:
            setattr(mod, attr, w)
            n += 1
        except Exception:
            _plog.exception("包装 %s.%s 失败", getattr(mod, "__name__", "?"), attr)

    _plog.info("服务层日志已接入，包装 %d 个函数（debug 级，详情见 wsp.log）", n)
    return n > 0


