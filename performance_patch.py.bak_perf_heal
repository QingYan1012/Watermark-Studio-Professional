# ======================================================================
# 第35轮画布交互修复：① 取消滚轮缩放（仅保留双击 1:1↔适应）
#                    ② 拖 sash/窗口 resize 节流 + 不再每帧重画点阵/阴影
#
# 根因②：legacy _on_canvas_resize 每 30ms 重绘一次，且每次清空 _dotgrid_cache /
#   _shadow_cache，导致第7/8项“交互复用点阵/阴影”的优化被废——拖分隔条时每帧重画
#   几千个椭圆点阵 + 重算高斯模糊，是“拖列表栏卡顿”的主因。
#   修复：包装 _build_canvas，在 orig 之后用闭包重绑 <Configure> 到节流版
#   （120ms 一帧、不清点阵/阴影缓存，松手 settle 时 interacting=False 再补正确尺寸）；
#   同时 unbind 画布滚轮缩放（<MouseWheel>/<Button-4>/<Button-5>），缩放只留双击。
#
# 为何包装 _build_canvas 而非覆盖类方法：legacy 在 _build_canvas 内用
#   self.canvas.bind("<Configure>", self._on_canvas_resize) 绑定，绑定方法对象在
#   bind 时已捕获旧函数，事后覆盖类方法对已绑定回调无效（bound-method 陷阱）。
#   故在 orig 执行后 unbind + 用 lambda 闭包重绑，确保生效；主题切换重建画布时
#   本包装随 _build_canvas 再次执行，自动重新生效。
# ======================================================================

def _throttled_canvas_resize(self, _event):
    """节流版画布 resize：120ms 一帧，且不清点阵/阴影缓存（让交互复用生效）。"""
    try:
        self._resize_interacting = True
    except Exception:
        pass
    try:
        self._preview_cache = None
    except Exception:
        pass
    # 故意不清 self._dotgrid_cache / self._shadow_cache：
    # 拖 sash/窗口期间 _is_interacting()=True，_perf_ensure_dotgrid/_perf_ensure_shadow
    # 会复用旧图，避免每帧重画几千点阵/重算模糊；松手 settle 时 interacting=False，
    # 因尺寸已变，_perf_ensure_* 走 original 重画正确尺寸。
    if getattr(self, "_resize_after_id", None):
        try:
            self.after_cancel(self._resize_after_id)
        except Exception:
            pass
    self._resize_after_id = self.after(120, self._redraw_canvas)
    if getattr(self, "_resize_settle_id", None):
        try:
            self.after_cancel(self._resize_settle_id)
        except Exception:
            pass
    self._resize_settle_id = self.after(250, self._resize_settle)


def _install_panel_border_fix(App):
    """第41轮：圆角卡片亮暗对称根治（取代第38~40轮的反复横跳）。

    横跳真凶（前几轮没看清）：① 面板描边——亮色需要它勾边、暗色嫌它比 panel 亮→亮框，
    在“删描边/调深窗口底”间补偿只会制造新的不对称；② 中间 PanedWindow 误设成 panel 色→
    中间变 panel 直角大矩形，暗色下 vs 窗口底显形成亮框、并吃掉面板圆角。

    对称正解（结构正确、不猜像素）：
    1) 面板/工具栏/底栏 保留 border_width=1，但 border_color 用【跨角色元组】
       (light_border2, dark_bg)：亮=比白 panel 深的浅灰勾边(清晰)，暗=比深 panel 更深的
       近黑勾边(暗勾边，绝不刺眼)。亮暗皆“比 panel 深的勾边”→圆角都清晰、暗色无亮线。
       手组元组而非 T()：T 只给同角色亮暗对，给不了跨角色组合；CTk 按 appearance_mode 选值。
    2) PanedWindow 底色=【窗口 bg】(非 panel!)，sash 跟 bg，retheme 翻 bg→bg。面板圆角缺角
       露窗口 bg(比 panel 深)→圆角外侧深色→圆角可见；缝=窗口底色缝。纠正前几轮 panel 色之误。
    3) 不再调深亮色窗口底(本函数不含第38轮那行 TH["light"]["bg"]="#e9ebef"，整段替换即撤销)：
       恢复原始 #f5f6f8，亮暗结构完全对称(皆“卡片浮在自己窗口底上”)，杜绝不对称补偿。

    结果：亮=白卡+浅灰勾边浮浅灰底；暗=深卡+近黑勾边浮近黑底。两态对称，圆角清晰，
    无亮框/破角/亮带。回退 WS_PERF_PANEL_BORDER=0 → legacy 原貌(仅供对照)。
    """
    if getattr(App, "_panel_border_fix_installed", False):
        return True
    if not _PANEL_BORDER_FIX_ENABLED:
        return False

    legacy = _find_legacy_module()
    if legacy is None:
        return False
    TH = getattr(legacy, "THEMES", None)
    THEME = getattr(legacy, "THEME", None)
    T = getattr(legacy, "T", None)
    if not (TH and THEME and callable(T)):
        return False

    # 跨角色勾边元组：亮用 border2(比白深)、暗用 bg(比深 panel 更深→暗勾边)。
    try:
        _EDGE = (TH["light"]["border2"], TH["dark"]["bg"])
    except Exception:
        _EDGE = T("border")

    # 1) 面板：圆角12 + 跨角色勾边。
    orig_panel = App._panel

    def _patched_panel(self, master):
        try:
            # 【第42轮】border_width=0：物理消除 panel 边框这条亮线来源，与主题无关、创建即永久；
            # 亮/暗浮起皆靠 panel 与窗口底色差（亮色已验证不靠 border 勾边，故去 border 无损）。
            frame = ctk.CTkFrame(
                master, corner_radius=12, fg_color=T("panel"), border_width=0,
            )
        except Exception:
            try:
                frame = orig_panel(self, master)
            except Exception:
                _log.exception("_panel 覆盖失败")
                return None
        try:
            _lst = getattr(self, "_perf_panel_frames", None)
            if _lst is None:
                _lst = []
                self._perf_panel_frames = _lst
            _lst.append(frame)
        except Exception:
            pass
        return frame

    App._panel = _patched_panel
    
    # 2) 工具栏/底栏：同款圆角12 + 跨角色勾边，统一全软件圆角语言。
    def _style_bar(frame):
        if frame is None:
            return
        try:
            frame.configure(corner_radius=12, border_width=1, border_color=_EDGE)
        except Exception:
            pass

    if hasattr(App, "_build_toolbar"):
        _otb = App._build_toolbar

        def _wtb(self):
            _otb(self)
            _style_bar(getattr(self, "_toolbar", None))

        App._build_toolbar = _wtb

    if hasattr(App, "_build_bottom_bar"):
        _obb = App._build_bottom_bar

        def _wbb(self):
            _obb(self)
            _style_bar(getattr(self, "_bottom_bar", None))

        App._build_bottom_bar = _wbb

    # 3) PanedWindow 底色=窗口 bg(非 panel!)，登记角色钉死 bg→bg，retheme 自动翻。
    #    clear+赋值 彻底覆盖 legacy 原始登记的 bg="border"，不残留旧键。
    if hasattr(App, "_build_layout"):
        _ob = App._build_layout

        def _wb(self):
            _ob(self)
            mp = getattr(self, "main_paned", None)
            if mp is None:
                return
            try:
                mp.configure(bg=THEME.get("bg"))
            except Exception:
                pass
            try:
                NW = getattr(legacy, "_NATIVE_WIDGETS", None)
                if NW is not None:
                    for _w, _roles in NW:
                        if _w is mp and isinstance(_roles, dict):
                            _roles.clear()
                            _roles["bg"] = "bg"
            except Exception:
                pass
            # 【第42轮】工具栏/底栏也去 border（它们 legacy 直接建、用 T("border")，暗色同样亮线）；
            # bw=0 与主题无关，build 时设一次永久生效。浮起靠 panel vs 窗口底色差。
            for _bn in ("_toolbar", "_bottom_bar"):
                _bf = getattr(self, _bn, None)
                if _bf is not None:
                    try:
                        _bf.configure(border_width=0)
                    except Exception:
                        pass
            # 【第42轮诊断】打印实际生效值，一次确诊亮线来源（WS_PERF_DEBUG_BORDER=0 可关）
            try:
                if os.environ.get("WS_PERF_DEBUG_BORDER", "1") != "0":
                    _pf = getattr(self, "_perf_panel_frames", None) or []
                    _p0 = _pf[0] if _pf else None
                    _log.info(
                        "[WS-BORDER] paned.bg=%r | panel0.bw=%r border_color=%r | n_panels=%d",
                        mp.cget("bg"),
                        (_p0.cget("border_width") if _p0 else None),
                        (_p0.cget("border_color") if _p0 else None),
                        len(_pf),
                    )
            except Exception:
                _log.exception("[WS-BORDER] 诊断打印失败")

        App._build_layout = _wb
        
    App._panel_border_fix_installed = True
    return True

