_PREFLIGHT_CODE_LABEL = {
    "ELEM_OUT_OF_BOUNDS": "元素超出边界（导出可能被裁切）",
    "IMAGE_PATH_MISSING": "图标文件缺失（导出不会显示该图标）",
    "PLACEHOLDER_UNRESOLVED": "占位符未匹配数据（导出将原样保留花括号）",
    "FONT_TOO_SMALL": "字号过小（打印或缩小后难辨认）",
}


def _preflight_inspect(self):
    if not _PREFLIGHT_ENABLED or not _HAS_INSPECTOR or _inspect_template is None:
        return []

    try:
        tmpl = self.template
        images = self.images
        fm = getattr(self, "font_manager", None)
        out = []

        for e in images:
            pil = getattr(e, "pil_image", None)

            if pil is not None:
                try:
                    size = pil.size
                except Exception:
                    continue
            else:
                if Image is None:
                    continue
                try:
                    with Image.open(e.path) as _im:
                        size = _im.size
                except Exception:
                    continue

            try:
                issues = _inspect_template(
                    tmpl, size,
                    data=getattr(e, "data", None),
                    font_manager=fm,
                )
            except Exception:
                continue

            warns = [i for i in issues if getattr(i, "level", "") == "warn"]
            if warns:
                out.append((os.path.basename(getattr(e, "path", "?")), warns))

        return out
    except Exception:
        _log.exception("导出前体检整体异常，跳过 preflight")
        return []


def _confirm_preflight(self, preflight):
    try:
        total = len(self.images)
        n_warn = len(preflight)

        code_counter = {}
        for _base, warns in preflight:
            for i in warns:
                c = getattr(i, "code", "?")
                code_counter[c] = code_counter.get(c, 0) + 1

        lines = [
            "导出前体检：共 %d 张图片，其中 %d 张存在潜在问题。" % (total, n_warn),
            "",
            "问题汇总：",
        ]
        for code, cnt in sorted(code_counter.items(), key=lambda kv: -kv[1]):
            lines.append("  · %s：%d 张" % (_PREFLIGHT_CODE_LABEL.get(code, code), cnt))

        lines.append("")
        lines.append("示例（前 %d 张）：" % min(5, n_warn))
        for base, warns in preflight[:5]:
            codes = sorted({getattr(i, "code", "?") for i in warns})
            short = "、".join(
                _PREFLIGHT_CODE_LABEL.get(c, c).split("（")[0] for c in codes
            )
            lines.append("  · %s：%s" % (base, short))
        if n_warn > 5:
            lines.append("  · …另有 %d 张未列出" % (n_warn - 5))

        lines.append("")
        lines.append("点『是』忽略警告继续导出；点『否』取消并返回修改。")

        return bool(_tk_mb.askyesno("导出前体检", "\n".join(lines)))
    except Exception:
        _log.exception("导出前体检确认框异常，默认继续导出")
        return True


def _install_export_fix(App):
    if getattr(App, "_export_fix_installed", False):
        return True
    if not _HAS_RENDERER:
        return False
    if not hasattr(App, "on_batch_export"):
        return False

    base_export = _make_fixed_batch_export()

    def _preflight_then_export(self):
        preflight = _preflight_inspect(self)
        if preflight and not _confirm_preflight(self, preflight):
            return
        return base_export(self)

    App.on_batch_export = _preflight_then_export
    App._export_fix_installed = True
    return True


# ======================================================================
# Smart Output：底栏第2列注入“输出尺寸”OptionMenu（含自定义…档）。
#
# 注入到独立 grid 列（col2），完全不碰 legacy right 容器的 pack 树 → 零破坏现有
# “选择输出目录/进度条/批量导出/导出当前”按钮。ctk 缺失 / 开关关 / 任何异常 → 跳过，
# worker 读不到 self._smart_output_mode 时默认“原图” → 导出零回归。
#
# 主题切换会整窗重建底栏（_build_layout→_build_bottom_bar），每次 orig 都新建 bar，
# 故 _wrapped 每次跑完 orig 都向新 bar 注入一次（无需 injected 永久 flag，否则重建后控件丢失）。
# 用户上次的选择用普通属性 self._smart_output_mode_label 跨重建保留。
# ======================================================================

def _smart_lookup(label):
    for lab, mode, px in _SMART_OPTIONS:
        if lab == label:
            return mode, px
    return "原图", 0


def _on_smart_output_change(self, label):
    """OptionMenu 回调（三分支）。
    - “自定义…”：用户从下拉点了伪选项 → 弹自定义窗（窗内负责 set/restore）。
    - 以“自定义”开头的显示文本：重建回填或弹框 set 后的显示态 → 保留当前 mode/px，
      仅同步 mode_label；绝不能走 _smart_lookup（否则查不到会回退“原图”，毁掉自定义值）。
    - 其余：固定 7 档 → 正常查表，并记为“上一有效档”供自定义取消时恢复。
    """
    if label == "自定义…":
        _open_custom_dialog(self)
        return
    if isinstance(label, str) and label.startswith("自定义"):
        self._smart_output_mode_label = label
        return
    mode, px = _smart_lookup(label)
    self._smart_output_mode = mode
    self._smart_output_px = px
    self._smart_output_mode_label = label
    self._smart_output_last_label = label


def _open_custom_dialog(self):
    """自定义输出尺寸弹窗（第45轮：单位 像素/厘米/毫米/英寸 + DPI + 实时换算预览）。

    存储语义（避免回填错乱）：
      _custom_last_value 用户【原始输入】的尺寸数值（按当时单位），回填数值框；
      _custom_last_unit  单位标签；_custom_last_dpi DPI（仅物理单位参与换算）；
      _custom_last_type  规则类型。
    写入 worker 读的 self._smart_output_px 的是【换算后整数像素】——转换在确定时一次完成，
    后台线程只吃像素、不碰单位。显示文本保留“用户视角物理量+@dpi”，所见即所设。
    老兼容：无 _custom_last_value 时退回 _custom_last_px 且单位强制“像素”。
    实时预览：数值/单位/DPI 任一变化即重算“≈ N px”，换算可见可核对。
    """
    if ctk is None:
        return

    _UNITS = ["像素", "厘米", "毫米", "英寸"]

    def _factor(unit, dpi):
        # 每单位多少像素：像素=1；英寸=dpi；厘米=dpi/2.54；毫米=dpi/25.4
        if unit == "英寸":
            return float(dpi)
        if unit == "厘米":
            return float(dpi) / 2.54
        if unit == "毫米":
            return float(dpi) / 25.4
        return 1.0

    cur_type = getattr(self, "_custom_last_type", _CUSTOM_TYPES[0])
    if cur_type not in _CUSTOM_TYPES:
        cur_type = _CUSTOM_TYPES[0]
    cur_unit = getattr(self, "_custom_last_unit", "像素")
    if cur_unit not in _UNITS:
        cur_unit = "像素"
    try:
        cur_dpi = int(getattr(self, "_custom_last_dpi", 300))
    except Exception:
        cur_dpi = 300
    if cur_dpi <= 0:
        cur_dpi = 300
    cur_val = getattr(self, "_custom_last_value", None)
    if cur_val is None:
        cur_val = getattr(self, "_custom_last_px", 1920)
        cur_unit = "像素"

    win = ctk.CTkToplevel(self)
    win.title("自定义输出尺寸")
    win.geometry("340x340")
    try:
        legacy = _find_legacy_module()
        T = getattr(legacy, "T", None) if legacy else None
        if callable(T):
            win.configure(fg_color=T("bg"))
    except Exception:
        T = None
    try:
        win.grab_set()
    except Exception:
        pass

    ui_font = getattr(self, "ui_font", None)
    dim = T("text_dim") if callable(T) else None
    acc = T("accent") if callable(T) else None

    ctk.CTkLabel(win, text="规则类型", text_color=dim, font=ui_font, anchor="w"
                 ).pack(fill="x", padx=16, pady=(14, 2))
    type_var = tk.StringVar(value=cur_type)
    ctk.CTkOptionMenu(win, values=list(_CUSTOM_TYPES), variable=type_var,
                      width=200, font=ui_font).pack(padx=16, anchor="w")

    ctk.CTkLabel(win, text="尺寸值", text_color=dim, font=ui_font, anchor="w"
                 ).pack(fill="x", padx=16, pady=(10, 2))
    val_row = ctk.CTkFrame(win, fg_color="transparent")
    val_row.pack(fill="x", padx=16, anchor="w")
    px_var = tk.StringVar(value=str(cur_val))
    ctk.CTkEntry(val_row, textvariable=px_var, width=150, font=ui_font).pack(side="left")
    unit_var = tk.StringVar(value=cur_unit)
    ctk.CTkOptionMenu(val_row, values=_UNITS, variable=unit_var,
                      width=80, font=ui_font).pack(side="left", padx=(8, 0))

    ctk.CTkLabel(win, text="DPI（厘米/毫米/英寸时生效，打印常用 300）",
                 text_color=dim, font=ui_font, anchor="w"
                 ).pack(fill="x", padx=16, pady=(10, 2))
    dpi_var = tk.StringVar(value=str(cur_dpi))
    ctk.CTkEntry(win, textvariable=dpi_var, width=150, font=ui_font).pack(padx=16, anchor="w")

    prev = tk.StringVar(value="—")
    ctk.CTkLabel(win, textvariable=prev, text_color=acc, font=ui_font, anchor="w"
                 ).pack(fill="x", padx=16, pady=(8, 0))

    def _update_preview(*_):
        try:
            v = float(px_var.get())
            d = float(dpi_var.get())
            u = unit_var.get()
            if v <= 0 or d <= 0:
                raise ValueError
            if u == "像素":
                prev.set("= %d px" % int(v))
            else:
                prev.set("≈ %d px（%g%s @ %gdpi）" % (round(v * _factor(u, d)), v, u, int(d)))
        except Exception:
            prev.set("—")

    for _var in (px_var, unit_var, dpi_var):
        try:
            _var.trace_add("write", _update_preview)
        except Exception:
            pass
    _update_preview()

    btn_row = ctk.CTkFrame(win, fg_color="transparent")
    btn_row.pack(fill="x", padx=16, pady=(14, 14))

    def do_cancel():
        try:
            self._smart_output_var.set(
                getattr(self, "_smart_output_last_label", None) or _SMART_DEFAULT_LABEL)
        except Exception:
            pass
        try:
            win.destroy()
        except Exception:
            pass

    def do_ok():
        u = unit_var.get()
        if u not in _UNITS:
            u = "像素"
        t = type_var.get()
        if t not in _CUSTOM_TYPES:
            t = _CUSTOM_TYPES[0]
        try:
            raw = px_var.get().strip()
            val = int(raw) if u == "像素" else float(raw)
        except Exception:
            try:
                _tk_mb.showerror("输入无效", "尺寸值格式不对（像素需整数）。", parent=win)
            except Exception:
                pass
            return
        if val <= 0:
            try:
                _tk_mb.showerror("输入无效", "尺寸值必须大于 0。", parent=win)
            except Exception:
                pass
            return
        try:
            dpi = int(float(dpi_var.get()))
        except Exception:
            dpi = 300
        if dpi <= 0:
            dpi = 300
        px = int(val) if u == "像素" else int(round(val * _factor(u, dpi)))
        if px <= 0:
            try:
                _tk_mb.showerror("输入无效", "换算后的像素必须大于 0。", parent=win)
            except Exception:
                pass
            return

        self._custom_last_type = t
        self._custom_last_unit = u
        self._custom_last_dpi = dpi
        self._custom_last_value = val
        self._smart_output_mode = t
        self._smart_output_px = px
        disp = ("自定义: %s %dpx" % (t, px)) if u == "像素" else ("自定义: %s %g%s@%ddpi" % (t, val, u, dpi))
        self._smart_output_mode_label = disp
        self._smart_output_last_label = disp
        try:
            self._smart_output_var.set(disp)
        except Exception:
            pass
        try:
            win.destroy()
        except Exception:
            pass

    ctk.CTkButton(btn_row, text="取消", width=80,
                  fg_color=T("panel") if callable(T) else None,
                  text_color=T("text_mid") if callable(T) else None,
                  hover_color=T("panel3") if callable(T) else None,
                  font=ui_font, command=do_cancel).pack(side="right", padx=(8, 0))
    ctk.CTkButton(btn_row, text="确定", width=80,
                  fg_color=T("ok") if callable(T) else None,
                  hover_color=T("ok_hover") if callable(T) else None,
                  text_color="white", font=ui_font, command=do_ok).pack(side="right")

    try:
        win.protocol("WM_DELETE_WINDOW", do_cancel)
    except Exception:
        pass
    try:
        win.focus_set()
    except Exception:
        pass

def _install_smart_output(App):
