            # 同步普通属性（worker 读它，跨线程安全）；保留跨重建的选择
            _on_smart_output_change(self, cur_label)
        except Exception:
            _log.exception("Smart Output 控件注入失败，批量导出将按原图（零回归）")

    App._build_bottom_bar = _wrapped
    App._smart_output_installed = True
    return True


# ======================================================================
# Smart Output 接管“导出当前”：与批量导出共用同一 _apply_smart_resize，
# 使两者 resize 行为永远一致（选尺寸→都缩；原图/关开关→都原图）。
#
# legacy on_export_current 的 render+save 是紧挨两行、无可插值钩子，故镜像复刻整段骨架
# （算法仍调共享 _render_template / _apply_smart_resize，不复制算法）。顺手补 legacy 漏掉的
# pil_image 懒加载（与 on_rotate 等同模式），防极端 None 崩；正常路径无影响。
# filedialog 在函数内 import，使本块自包含、不污染顶部 import。
# ======================================================================

def _fixed_export_current(self):
    if self.current_index is None:
        _tk_mb.showinfo("提示", "请先选择一张图片。")
        return

    entry = self.images[self.current_index]

    if getattr(entry, "pil_image", None) is None:
        try:
            entry.pil_image = Image.open(entry.path).convert("RGB")
        except Exception as e:
            _tk_mb.showerror("导出失败", "无法打开图片：%s" % e)
            return

    # 【第51/54轮】系统变量注入：渲染用增强 data 副本，带原图尺寸。
    try:
        _data = {**(entry.data or {}), **system_vars_fragment(self.current_index + 1, len(self.images), entry.path, entry.pil_image.size)} if system_vars_fragment is not None else entry.data
    except Exception:
        _data = entry.data        

    try:
        initial = self._build_output_name(entry, self.rename_var.get())
    except Exception:
        b0, e0 = os.path.splitext(os.path.basename(entry.path))
        initial = b0 + e0

    # 【第51轮】文件名后处理：_build_output_name 内部用 entry.data（不含系统变量），
    # 故对其返回值再解析一次系统变量，让导出当前文件名也能用 {图片序号} 等。
    if resolve_system_vars is not None:
        try:
            _w, _h = entry.pil_image.size
            initial = resolve_system_vars(initial, {
                "index": self.current_index + 1,
                "total": len(self.images),
                "stem": os.path.splitext(os.path.basename(entry.path))[0],
                "width": _w, "height": _h,
            })
        except Exception:
            pass            

    out_path = filedialog.asksaveasfilename(
        title="导出当前图片",
        initialfile=initial,
        defaultextension=os.path.splitext(entry.path)[1],
    )
    if not out_path:
        return

    try:
        full = _render_template(
            entry.pil_image, self.template, data=_data,
            font_manager=self.font_manager, layer_cache=False,
        )
        full.save(out_path, quality=95)
        try:
            self._show_toast("已导出当前图片")
        except Exception:
            pass
        _tk_mb.showinfo("完成", "已导出：\n%s" % out_path)
    except Exception as e:
        _tk_mb.showerror("导出失败", str(e))

