# ======================================================================
# Smart Output 等比缩放（单一来源；批量 worker 与导出当前都调它）。
# mode="原图" 或 px<=0 → 原样返回；缩放失败 → 原样返回，绝不阻断导出。
# 仅当目标尺寸与现状不同才 resize，避免无谓重采样。
# ======================================================================
def _apply_smart_resize(img, mode, px):
    if img is None or not mode or mode == "原图":
        return img
    try:
        px = int(px)
    except Exception:
        return img
    if px <= 0:
        return img
    try:
        w, h = img.size
        if w <= 0 or h <= 0:
            return img

        if mode == "统一宽度":
            nw, nh = px, max(1, round(h * px / w))
        elif mode == "统一高度":
            nh, nw = px, max(1, round(w * px / h))
        elif mode == "最长边":
            if max(w, h) <= px:
                return img
            s = px / max(w, h)
            nw, nh = max(1, round(w * s)), max(1, round(h * s))
        elif mode == "最短边":
            if min(w, h) <= px:
                return img
            s = px / min(w, h)
            nw, nh = max(1, round(w * s)), max(1, round(h * s))
        else:
            return img

        if (nw, nh) == (w, h):
            return img
        return img.resize((nw, nh), Image.LANCZOS)
    except Exception:
        return img


