            persp_ok, async_ok, prefetch_ok, svc_log_ok, smart_ok, canvas_ix_ok, panel_border_ok, _HAS_INSPECTOR, _SMOOTH_ENABLED,
            _SETTLE, _PP,
            getattr(fn, "__name__", "?"),
