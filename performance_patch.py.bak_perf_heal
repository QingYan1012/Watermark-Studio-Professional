def _find_app_class():
    ui_module = sys.modules.get("ui")
    if ui_module is not None and hasattr(ui_module, "App"):
        return ui_module.App

    for module_name, module in list(sys.modules.items()):
        if module_name.startswith("watermark_studio_legacy_ui") and hasattr(module, "App"):
            return module.App

    for module_name in ("ui.main_window", "ui.app", "ui.application", "ui.legacy_app"):
        try:
            module = importlib.import_module(module_name)
        except Exception:
            continue
        if hasattr(module, "App"):
            return module.App

    return None


def _find_legacy_module():
    module = sys.modules.get("ui.legacy_app")
    if module is not None and hasattr(module, "App"):
        return module

    for module_name, module in list(sys.modules.items()):
        if module_name.startswith("watermark_studio_legacy_ui") and hasattr(module, "App"):
            return module

    return None


