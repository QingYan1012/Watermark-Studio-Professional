def _install_performance_patches(App):
    if getattr(App, "_perf_patch_installed", False):
        return True

    if not hasattr(App, "_redraw_canvas"):
        return False

    legacy = _find_legacy_module()

    if legacy is not None:
        for key, value in _PREVIEW_CAPS.items():
            if hasattr(legacy, key):
                try:
                    setattr(legacy, key, value)
                except Exception:
                    pass

        if _template_unresolved_fields is not None and hasattr(legacy, "template_unresolved_fields"):
            original_unresolved = legacy.template_unresolved_fields

            def _perf_template_unresolved_fields(template, data):
                if _STATE.get("interacting"):
                    return {}
                try:
                    return original_unresolved(template, data)
                except Exception:
                    return {}

            legacy.template_unresolved_fields = _perf_template_unresolved_fields

    # ---- 重绘请求合并 ----
    if hasattr(App, "_flush_redraw"):
        def _perf_request_redraw(self):
            if getattr(self, "_redraw_after_id", None) is None:
                self._redraw_after_id = self.after(
                    _REDRAW_INTERVAL_MS,
                    self._flush_redraw,
                )

        App._request_redraw = _perf_request_redraw

    # ---- 交互期间暂停撤销快照 + 维护全局交互状态 + 占位覆盖 ----
    original_redraw_canvas = App._redraw_canvas

    def _perf_redraw_canvas(self):
        undo_guard = False
        interacting = False

        try:
            interacting = self._is_interacting()
        except Exception:
            interacting = False

        _STATE["interacting"] = interacting

        try:
            if interacting and not getattr(self, "_undo_in_progress", False):
                self._undo_in_progress = True
                undo_guard = True
        except Exception:
            undo_guard = False

        result = None
        try:
            result = original_redraw_canvas(self)
        finally:
            if undo_guard:
                try:
                    self._undo_in_progress = False
                except Exception:
                    pass
            _STATE["interacting"] = False

        try:
            st = _perf_load_state(self)
            if st in ("loading", "failed"):
                _draw_loading_placeholder(self, st)
            elif st == "empty" and _EMPTY_STATE_FIX_ENABLED:
                _draw_empty_state(self)
        except Exception:
            pass
            
        return result

    App._redraw_canvas = _perf_redraw_canvas

    # ---- 交互期间点阵复用上一帧 ----
    original_ensure_dotgrid = getattr(App, "_ensure_dotgrid", None)

    if original_ensure_dotgrid is not None and _SMOOTH_ENABLED:
        def _perf_ensure_dotgrid(self, cw, ch):
            try:
                interacting = self._is_interacting()
            except Exception:
                interacting = False

            if interacting:
                c = getattr(self, "_dotgrid_cache", None)
                if c is not None and c.get("img") is not None:
                    return c["img"]

            return original_ensure_dotgrid(self, cw, ch)

        App._ensure_dotgrid = _perf_ensure_dotgrid

    # ---- 交互期间阴影不重算模糊 ----
    original_ensure_shadow = getattr(App, "_ensure_shadow", None)

    if original_ensure_shadow is not None and Image is not None:
        def _perf_ensure_shadow(self, size):
            try:
                interacting = self._is_interacting()
            except Exception:
                interacting = False

            if not interacting:
                return original_ensure_shadow(self, size)

            c = getattr(self, "_shadow_cache", None)
            if c is not None and c.get("size") == size and c.get("img") is not None:
                return c["img"], c["pad"]

            if not _SMOOTH_ENABLED:
                cache = getattr(self, "_perf_shadow_cache", None)
                if cache is not None and cache.get("size") == size:
                    return cache["img"], cache["pad"]
                try:
                    w, h = size
                    pad = 16
                    sh = Image.new("RGBA", (w + pad * 2, h + pad * 2), (0, 0, 0, 0))
                    ImageDraw.Draw(sh).rounded_rectangle(
                        [pad - 1, pad - 1, pad + w + 1, pad + h + 1],
                        radius=2, fill=(0, 0, 0, 70),
                    )
                    sh = sh.filter(ImageFilter.BoxBlur(3))
                    tkimg = ImageTk.PhotoImage(sh)
                    self._perf_shadow_cache = {"size": size, "img": tkimg, "pad": pad}
                    return tkimg, pad
                except Exception:
                    return original_ensure_shadow(self, size)

            empty = getattr(self, "_perf_empty_shadow", None)
            if empty is None:
                try:
                    empty = ImageTk.PhotoImage(Image.new("RGBA", (1, 1), (0, 0, 0, 0)))
                    self._perf_empty_shadow = empty
                except Exception:
                    return original_ensure_shadow(self, size)
            return empty, 0

        App._ensure_shadow = _perf_ensure_shadow

    # ---- 交互期间标尺完全跳过 ----
    original_draw_rulers = getattr(App, "_draw_rulers", None)

    if original_draw_rulers is not None:
        def _perf_draw_rulers(self):
            try:
                interacting = self._is_interacting()
            except Exception:
                interacting = False

            if interacting:
                return

            try:
                original_draw_rulers(self)
            except Exception:
                pass

        App._draw_rulers = _perf_draw_rulers

    App._perf_patch_installed = True
    return True


# ======================================================================
# 异步高清补帧 + 统一尺寸
# ======================================================================

def _get_perf_preview_lock(self):
    lk = getattr(self, "_perf_preview_lock", None)
    if lk is None:
        lk = threading.Lock()
        self._perf_preview_lock = lk
    return lk


def _perf_compute_size(self, entry):
    w, h = entry.pil_image.size

    if self._pixel_perfect:
        scale = 1.0
        cap = _PREVIEW_CAPS["PIXEL_PERFECT_CAP"]
        if max(w, h) * scale > cap:
            scale = cap / max(w, h)
    else:
        avail_w = max(100, self.canvas.winfo_width() - 24)
        avail_h = max(100, self.canvas.winfo_height() - 24)
        fit_scale = min(avail_w / w, avail_h / h, 1.0)
        scale = max(0.02, fit_scale * self.canvas_zoom)
        scale = min(scale, 1.0)
        max_long = _PREVIEW_CAPS["MAX_PREVIEW_SETTLE"]
        long_edge = max(w, h) * scale
        if long_edge > max_long:
            scale *= max_long / long_edge

    size = (max(1, round(w * scale)), max(1, round(h * scale)))
    return size


def _perf_current_preview_source(self):
    if self.current_index is None or not self.images:
        return None, None, {}

    entry = self.images[self.current_index]
    if entry.pil_image is None:
        return None, None, {}

    # 【第51/54轮】系统变量片段：带原图尺寸 {原图宽}/{原图高}。预览/警告/bbox 共用这份增强 data。
    try:
        _frag = system_vars_fragment(self.current_index + 1, len(self.images), entry.path, entry.pil_image.size) if system_vars_fragment is not None else {}
    except Exception:
        _frag = {}        

    def _data():
        return {**(entry.data or {}), **_frag}

    try:
        size = _perf_compute_size(self, entry)
    except Exception:
        return None, None, {}

    src_id = id(entry.pil_image)
    idx = self.current_index
    interacting = self._is_interacting()

    lock = _get_perf_preview_lock(self)

    with lock:
        c = getattr(self, "_perf_preview_cache", None)
        cache_hit = bool(
            c is not None
            and c.get("index") == idx
            and c.get("source_id") == src_id
            and c.get("size") == size
        )
        cached_img = c.get("img") if cache_hit else None
        cached_quality = bool(c.get("quality")) if cache_hit else False

    if interacting:
        if cached_img is not None:
            return cached_img, size, _data()
        try:
            small = entry.pil_image.resize(size, Image.BILINEAR)
        except Exception:
            return None, None, {}
        with lock:
            self._perf_preview_cache = {
                "index": idx, "source_id": src_id, "size": size,
                "img": small, "quality": False,
            }
        return small, size, _data()

    if cache_hit and cached_quality and cached_img is not None:
        return cached_img, size, _data()

    fallback = cached_img
    if fallback is None:
        try:
            fallback = entry.pil_image.resize(size, Image.BILINEAR)
        except Exception:
            return None, None, {}
        with lock:
            self._perf_preview_cache = {
                "index": idx, "source_id": src_id, "size": size,
                "img": fallback, "quality": False,
            }

    if _ASYNC_PREVIEW_ENABLED:
        token = (idx, src_id, size)
        with lock:
            if getattr(self, "_perf_preview_pending_token", None) != token:
                self._perf_preview_pending_token = token
                try:
                    threading.Thread(
                        target=_perf_bg_lanczos,
                        args=(self, token, entry.pil_image, size),
                        daemon=True,
                    ).start()
                except Exception:
                    self._perf_preview_pending_token = None

    return fallback, size, _data()

def _perf_bg_lanczos(self, token, pil, size):
    hi = None
    try:
        hi = pil.resize(size, Image.LANCZOS)
    except Exception:
        hi = None

    lock = _get_perf_preview_lock(self)
    apply_ok = False

    with lock:
        if getattr(self, "_perf_preview_pending_token", None) != token:
            return
        cur = getattr(self, "_perf_preview_cache", None)
        if (
            hi is not None
            and cur is not None
            and cur.get("index") == token[0]
            and cur.get("source_id") == token[1]
            and cur.get("size") == token[2]
            and not cur.get("quality")
        ):
            cur["img"] = hi
            cur["quality"] = True
            apply_ok = True
        self._perf_preview_pending_token = None

    if apply_ok:
        try:
            self.after(0, self._request_redraw)
        except Exception:
            pass


def _install_async_preview(App):
    if getattr(App, "_async_preview_installed", False):
        return True
    if Image is None:
        return False
    if not hasattr(App, "_current_preview_source"):
        return False

    App._current_preview_source = _perf_current_preview_source
    App._perf_bg_lanczos = _perf_bg_lanczos
    App._get_perf_preview_lock = _get_perf_preview_lock
    App._async_preview_installed = True
    return True


# ======================================================================
# 切图预解码
# ======================================================================

def _perf_prefetch_neighbors(self, idx):
    if not _PREFETCH_ENABLED:
        return

    try:
        n = len(self.images)
    except Exception:
        return

    seen = set()
    snap = []

    for d in (1, -1, 2, -2):
        j = idx + d
        if j < 0 or j >= n or j in seen:
            continue
        seen.add(j)
        try:
            e = self.images[j]
        except Exception:
            continue
        if getattr(e, "pil_image", None) is None and not getattr(e, "_load_failed", False):
            snap.append((j, e.path, e))

    if not snap:
        return

    token = tuple(j for j, _, _ in snap)
    if getattr(self, "_perf_prefetch_token", None) == token:
        return
    self._perf_prefetch_token = token

    def worker():
        for j, path, e in snap:
            try:
                if self.current_index == j:
                    continue
                if getattr(e, "pil_image", None) is not None:
                    continue
                if getattr(e, "_load_failed", False):
                    continue

                pil = Image.open(path).convert("RGB")

                if self.current_index == j:
                    continue
                if getattr(e, "pil_image", None) is not None:
                    continue

                e.pil_image = pil
                try:
                    e._orig_loaded_id = id(pil)
                except Exception:
                    pass
            except Exception:
                try:
                    e._load_failed = True
                except Exception:
                    pass

    try:
        threading.Thread(target=worker, daemon=True).start()
    except Exception:
        pass


def _install_load_prefetch(App):
    if getattr(App, "_load_prefetch_installed", False):
        return True
    if Image is None:
        return False
    if not hasattr(App, "_load_current"):
        return False

    def _perf_load_current(self, idx):
        self.current_index = idx

        try:
            entry = self.images[idx]
        except Exception:
            return

        pil = getattr(entry, "pil_image", None)
        failed = getattr(entry, "_load_failed", False)

        # 已解码 / 已失败 / 开关关 → 同步路径（与第9轮逐字等价，零变化）
        if pil is not None or failed or os.environ.get("WS_PERF_ASYNC_LOAD", "1") == "0":
            if pil is None and not failed:
                try:
                    entry.pil_image = Image.open(entry.path).convert("RGB")
                    try:
                        entry._orig_loaded_id = id(entry.pil_image)
                    except Exception:
                        pass
                except Exception as e:
                    entry._load_failed = True
                    if self.current_index == idx:
                        try:
                            _tk_mb.showerror(
                                "打开失败",
                                "无法打开图片：\n%s\n%s" % (entry.path, e),
                            )
                        except Exception:
                            pass
            self._redraw_canvas()
            try:
                _perf_prefetch_neighbors(self, idx)
            except Exception:
                pass
            return

        # 【走C第一刀】未解码 → 异步：先画“正在加载”占位（界面不冻），后台解码完回填。
        # 主线程此刻 pil=None,failed=False → _perf_redraw_canvas 内 _perf_load_state="loading" → 占位。
        self._redraw_canvas()

        def _worker():
            try:
                loaded = Image.open(entry.path).convert("RGB")
            except Exception as e:
                entry._load_failed = True

                def _err():
                    if self.current_index == idx:
                        self._redraw_canvas()
                        try:
                            _tk_mb.showerror(
                                "打开失败",
                                "无法打开图片：\n%s\n%s" % (entry.path, e),
                            )
                        except Exception:
                            pass

                try:
                    self.after(0, _err)
                except Exception:
                    pass
                return

            def _apply():
                if self.current_index != idx:
                    return  # 已切走，不贴旧图（race 保护）
                entry.pil_image = loaded
                try:
                    entry._orig_loaded_id = id(loaded)
                except Exception:
                    pass
                self._redraw_canvas()
                try:
                    _perf_prefetch_neighbors(self, idx)
                except Exception:
                    pass

            try:
                self.after(0, _apply)
            except Exception:
                pass

        try:
            threading.Thread(target=_worker, daemon=True).start()
        except Exception:
            # 起线程失败 → 退回同步，保证不丢图
            try:
                entry.pil_image = Image.open(entry.path).convert("RGB")
                try:
                    entry._orig_loaded_id = id(entry.pil_image)
                except Exception:
                    pass
            except Exception:
                entry._load_failed = True
            self._redraw_canvas()
            try:
                _perf_prefetch_neighbors(self, idx)
            except Exception:
                pass            

    App._load_current = _perf_load_current
    App._load_prefetch_installed = True
    return True


# ======================================================================
# 【走C第二刀】列表填充分批化：治“打开文件夹时千次 insert 冻窗口”。
# ≤BATCH 张走同步分支，与 legacy _apply_sort 逐字等价（new_idx 在 insert 循环内算、
# END 用 _TK_END）；>BATCH 张分批 after(0) 填充，让事件循环喘气，status_label 显进度，
# 全插完再 selection+load。_sort_entries 缺失时 install 守卫不装本函数。
# ======================================================================

def _async_apply_sort(self, keep_selection_path=None):
    self.images = _sort_entries(self.images, mode=self.sort_mode)
    self.image_listbox.delete(0, tk.END)
    n = len(self.images)
    BATCH = 80

    if n <= BATCH or not _ASYNC_LIST_ENABLED:
        # 同步分支：逐字等价 legacy 原版，12 张走这里，零额外开销、零行为差异。
        new_idx = 0
        for i, e in enumerate(self.images):
            self.image_listbox.insert(tk.END, os.path.basename(e.path))
            if keep_selection_path and e.path == keep_selection_path:
                new_idx = i
        self.status_label.configure(text=f"共 {n} 张图片")
        if self.images:
            self.image_listbox.selection_clear(0, tk.END)
            self.image_listbox.selection_set(new_idx)
            self.image_listbox.see(new_idx)
            self._load_current(new_idx)
        else:
            self.current_index = None
            self.canvas.delete("all")
            self._draw_rulers()
        return

    # 分批分支：先单独算 new_idx（取首匹配）。
    new_idx = 0
    if keep_selection_path:
        for i, e in enumerate(self.images):
            if e.path == keep_selection_path:
                new_idx = i
                break

    try:
        self.status_label.configure(text=f"正在加载列表 0/{n}…")
    except Exception:
        pass

    def fill(from_i):
        to_i = min(from_i + BATCH, n)
        try:
            for i in range(from_i, to_i):
                self.image_listbox.insert(tk.END, os.path.basename(self.images[i].path))
        except Exception:
            return
        if to_i < n:
            try:
                self.status_label.configure(text=f"正在加载列表 {to_i}/{n}…")
            except Exception:
                pass
            try:
                self.after(0, lambda f=to_i: fill(f))
            except Exception:
                pass
        else:
            try:
                self.status_label.configure(text=f"共 {n} 张图片")
            except Exception:
                pass
            if self.images:
                try:
                    self.image_listbox.selection_clear(0, tk.END)
                    self.image_listbox.selection_set(new_idx)
                    self.image_listbox.see(new_idx)
                except Exception:
                    pass
                try:
                    self._load_current(new_idx)
                except Exception:
                    pass
            else:
                self.current_index = None
                try:
                    self.canvas.delete("all")
                    self._draw_rulers()
                except Exception:
                    pass

    fill(0)


def _install_async_list_fill(App):
    if getattr(App, "_async_list_fill_installed", False):
