def _install_undo_fix(App):
    if getattr(App, "_undo_fix_installed", False):
        return True

    try:
        from model import Template
    except Exception:
        return False

    def _undo_fix_do(self, event=None):
        try:
            focus_widget = self.focus_get()
        except Exception:
            focus_widget = None

        if focus_widget is not None:
            try:
                if focus_widget.winfo_toplevel() is not self:
                    return
            except Exception:
                pass
            if isinstance(focus_widget, tk.Text):
                return

        timer = getattr(self, "_undo_timer", None)
        if timer:
            try:
                self.after_cancel(timer)
            except Exception:
                pass
            self._undo_timer = None

        pending = getattr(self, "_undo_pending_before", None)
        stack = getattr(self, "_undo_stack", None) or []

        if pending is not None:
            target = pending
            self._undo_pending_before = None
        elif stack:
            target = stack.pop()
        else:
            try:
                self._show_toast("没有可撤销的操作")
            except Exception:
                pass
            return "break"

        self._undo_in_progress = True
        try:
            self.template = Template.from_dict(target)
            self._undo_last = target
            try:
                self._refresh_element_list()
            except Exception:
                pass
            try:
                self._select_element(self.selected_elem_id)
            except Exception:
                pass
            try:
                self._show_toast("已撤销")
            except Exception:
                pass
        except Exception as exc:
            try:
                self._show_toast("撤销失败：%s" % exc)
            except Exception:
                pass
        finally:
            self._undo_in_progress = False

        return "break"

    App._un_do = _undo_fix_do

    original_build_layout = getattr(App, "_build_layout", None)
    if original_build_layout is None:
        return False

    def _undo_fix_build_layout(self):
        original_build_layout(self)
        if not getattr(self, "_undo_fix_bound", False):
            try:
                self.bind_all("<Control-z>", self._un_do)
                self.bind_all("<Control-Z>", self._un_do)
                self._undo_fix_bound = True
            except Exception:
                pass

    App._build_layout = _undo_fix_build_layout
    App._undo_fix_installed = True
    return True


# ----------------------------------------------------------------------
# 自包含撤销“记录”逻辑 + 劫持 legacy 全局名 _un_observe
# ----------------------------------------------------------------------

def _perf_un_snap(self):
    try:
        return self.template.to_dict()
    except Exception:
        return None


def _perf_un_push(self, d):
    if d is None:
        return
    st = getattr(self, "_undo_stack", None)
    if st is None:
        st = []
        self._undo_stack = st
    st.append(d)
    if len(st) > _UNDO_STACK_MAX:
        del st[:len(st) - _UNDO_STACK_MAX]


def _perf_un_observe(self):
    if getattr(self, "_undo_in_progress", False):
        return

    cur = _perf_un_snap(self)
    if cur is None:
        return

    last = getattr(self, "_undo_last", None)
    if last is None:
        self._undo_last = cur
        return
    if cur == last:
        return

    if getattr(self, "_undo_pending_before", None) is None:
        self._undo_pending_before = last
    self._undo_last = cur

    t = getattr(self, "_undo_timer", None)
    if t:
        try:
            self.after_cancel(t)
        except Exception:
            pass

    self._undo_timer = self.after(_UNDO_DEBOUNCE_MS, self._perf_un_commit)


def _perf_un_commit(self):
    self._undo_timer = None
    before = getattr(self, "_undo_pending_before", None)
    if before is not None:
        _perf_un_push(self, before)
    self._undo_pending_before = None


def _install_undo_observe(App):
    if getattr(App, "_undo_observe_installed", False):
        return True
    if not _UNDO_OBSERVE_ENABLED:
        return False

    legacy = _find_legacy_module()
    if legacy is None:
        return False

    if not hasattr(legacy, "_un_wrapped_redraw") and not hasattr(legacy, "_un_observe"):
        return False

    App._perf_un_commit = _perf_un_commit

    try:
        legacy._un_observe = _perf_un_observe
    except Exception:
        return False

    App._undo_observe_installed = True
    return True


